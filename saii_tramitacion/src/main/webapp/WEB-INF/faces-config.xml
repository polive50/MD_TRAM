<?xml version="1.0" encoding="UTF-8"?>

<!-- ============================================================== -->
<!-- Fichero de configuracion JSF -->
<!-- ============================================================== -->

<faces-config xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-facesconfig_2_3.xsd"
	version="2.3">

	<absolute-ordering>
		<name>omnifaces</name>
		<name>primefaces</name>
		<others />
	</absolute-ordering>

	<application>
		<!-- La definicion del siguiente resolver permite inyectar beans de spring 
			en los managed beans de JSF -->
		<el-resolver>org.springframework.web.jsf.el.SpringBeanFacesELResolver</el-resolver>
		<locale-config>
			<default-locale>es</default-locale>
			<supported-locale>es</supported-locale>
			<!-- Descomentar esta línea si se quiere soportar Inglés <supported-locale>en</supported-locale> -->
		</locale-config>
	</application>

</faces-config>