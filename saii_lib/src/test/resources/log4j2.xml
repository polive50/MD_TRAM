<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="error" strict="true" packages="atlas.core.log">
    <Properties>
        <!-- Desactiva la configuracion por defecto de Atlas (si se elimina, se considera activa)
        <Property name="desactivaConfigDefectoAtlas">true</Property>
        -->

        <!-- Ficheros de log -->
        <Property name="atlasFileLog">log/${project.artifactId}/${project.artifactId}_test.log</Property>
        <Property name="atlasFileLogError">log/${project.artifactId}/${project.artifactId}_test_errores.log</Property>
        <Property name="atlasSlowSqlFileLog">log/${project.artifactId}/${project.artifactId}_test_slowSql.log</Property>
        <Property name="atlasContextFileLog">log/${project.artifactId}/${project.artifactId}_test_context.log</Property>
        <Property name="atlasHibernateFileLog">log/${project.artifactId}/${project.artifactId}_test_hibernate.log</Property>

        <!--  IncludeLocations - Permite que se muestre el método que se está trazando
              Al ponerlo a true impacta en el rendimiento del log  -->
        <Property name="logIncludeLocations">TRUE</Property>
        <!-- Configuraciones extra para appenders -->
        <Property name="atlasLogPattern">[%d{dd/MM/yyyy-HH:mm:ss,SSS}][%p][%m][%c.%method][%X{request}][%X{usuario}][%X{sesion}][%X{idRequest}][%X{host}]%n</Property>
        <Property name="cronExpresionRotado">0 0 0 1/1 * ? *</Property>
        <Property name="numRotadosMaximos">10</Property>
            <!-- Activa el appender que escribe los errores a un fichero separado -->
        <Property name="activarFileLogError">false</Property>
            <!-- Activa el logado en local en un fichero (en lugar de solo por consola) -->
        <Property name="activarFileLogEntornoLocal">true</Property>
            <!-- Activa el log de tiempos de página en base de datos -->
        <Property name="activarLogDatabaseService">true</Property>

        <!-- Niveles de logs -->
        <Property name="rootLevel">info</Property>
        <Property name="levelTodoAtlas">info</Property>
        <Property name="levelSeguridad">info</Property>
        <Property name="levelFica">info</Property>
        <Property name="levelAtlasBusquedas">info</Property>
        <Property name="levelClientews">info</Property>
        <Property name="levelRestLib">info</Property>
        <Property name="levelAtlasComponentes">info</Property>
        <Property name="levelHibernateSQL">info</Property>
        <Property name="levelHibernate">info</Property>
        <Property name="levelLogAplicacion">info</Property>
        <Property name="levelAuditar">info</Property>
        <Property name="levelMessagesAxis">info</Property>
    </Properties>
    <Filters>
        <!-- Este filtro acepta todas las trazas.
        En caso de que se suba el nivel, solo se aceptarán aquellas de nivel más específico
        que el que aquí se indique -->
        <!-- Filter type="ThresholdFilter" level="trace" onMatch="NEUTRAL" onMismatch="DENY"/ -->
        <DynamicThresholdUserFilter key="level" defaultThreshold="ERROR" onMatch="ACCEPT" onMismatch="NEUTRAL" />
    </Filters>
    <Appenders>
        <Appender type="RollingRandomAccessFile" name="FILE_LOG" fileName="${atlasFileLog}" filePattern="${atlasFileLog}.%d{yyyy-MM-dd}.%i">
            <Filters>
                <Filter type="MarkerFilter" marker="DB_LOG" onMatch="DENY" onMismatch="NEUTRAL"/>
                <Filter type="ThresholdFilter" level="debug" onMatch="NEUTRAL" onMismatch="DENY"/>
            </Filters>
            <Layout type="PatternLayout" pattern="${atlasLogPattern}"/>
            <!-- Aquí se definen las políticas de rotado que deben cumplirse (alguna de ellas)
            para que se produzca el rotado del fichero de log -->
            <Policies>
                <!-- Se rota cuando se inicia la JVM -->
                <OnStartupTriggeringPolicy />
                <!-- Se rota cuando se superan los 5MB -->
                <SizeBasedTriggeringPolicy size="5 MB"/>
                <!-- Este CronTrigger hace que rote cada día a las 12PM -->
                <CronTriggeringPolicy schedule="${cronExpresionRotado}"/>
            </Policies>
            <DefaultRolloverStrategy max="${numRotadosMaximos}"/>
        </Appender>
        <Appender type="RollingRandomAccessFile" name="FILE_LOG_ERROR" fileName="${atlasFileLogError}" filePattern="${atlasFileLogError}.%d{yyyy-MM-dd}.%i">
            <Filters>
                <Filter type="MarkerFilter" marker="DB_LOG" onMatch="DENY" onMismatch="NEUTRAL"/>
                <Filter type="ThresholdFilter" level="error"/>
            </Filters>
            <Layout type="PatternLayout" pattern="${atlasLogPattern}"/>
            <!-- Aquí se definen las políticas de rotado que deben cumplirse (alguna de ellas)
            para que se produzca el rotado del fichero de log -->
            <Policies>
                <!-- Se rota cuando se inicia la JVM -->
                <OnStartupTriggeringPolicy />
                <!-- Se rota cuando se superan los 5MB -->
                <SizeBasedTriggeringPolicy size="5 MB"/>
                <!-- Este CronTrigger hace que rote cada día a las 12PM -->
                <CronTriggeringPolicy schedule="${cronExpresionRotado}"/>
            </Policies>
            <DefaultRolloverStrategy max="${numRotadosMaximos}"/>
        </Appender>
    </Appenders>
    <Loggers>
        <Logger name="org.madrid.saii.lib" level="${levelLogAplicacion}" includeLocation="${logIncludeLocations}"/>
        <Root/>
    </Loggers>
</Configuration>