<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
	http://maven.apache.org/maven-v4_0_0.xsd">

    <parent>
        <artifactId>atlasfrm-arquetipos-padre-jar</artifactId>
        <groupId>atlasfrm</groupId>
        <version>2.1.0</version>
        <relativePath></relativePath>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <groupId>org.madrid.saii</groupId>
    <artifactId>saii_lib</artifactId>
    <version>1.6.14</version>
    <packaging>jar</packaging>
    <name>${project.artifactId}</name>
    <description>Librería jar ${project.artifactId}</description>
    <url>${atlas.site.url}/${project.artifactId}</url>

    <!-- Directorio de despliegue del site. Modificar si se quiere generar 
        en otro sitio -->
    <distributionManagement>
        <site>
            <id>${project.artifactId}</id>
            <url>file:sitedesplegado/${project.artifactId}</url>
        </site>
    </distributionManagement>

    <properties>
        <basedirModule>${basedir}</basedirModule>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.2</version>
        </dependency>

        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>1.8.13</version>
        </dependency>

        <dependency>
            <groupId>org.jeasy</groupId>
            <artifactId>easy-random-core</artifactId>
            <version>4.3.0</version>
            <exclusions>
                <exclusion>
                    <groupId>io.github.classgraph</groupId>
                    <artifactId>classgraph</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.objenesis</groupId>
                    <artifactId>objenesis</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>atlasfrm</groupId>
            <artifactId>atlasfrm-dep-poi</artifactId>
            <version>${atlasfrm-dep-poi.version}</version>
            <type>pom</type>
        </dependency>

        <dependency>
            <groupId>atlasfrm</groupId>
            <artifactId>atlasfrm-starter-fica</artifactId>
        </dependency>

        <dependency>
            <groupId>atlasfrm</groupId>
            <artifactId>atlasfrm-eadm-lib</artifactId>
        </dependency>

        <dependency>
            <groupId>atlasfrm</groupId>
            <artifactId>atlasfrm-starter-crypt</artifactId>
        </dependency>

        <dependency>
            <groupId>atlasfrm</groupId>
            <artifactId>atlasfrm-starter-eadm</artifactId>
        </dependency>
        
        <dependency>
            <groupId>atlasfrm</groupId>
            <artifactId>atlasfrm-starter-enviocorreo</artifactId>
        </dependency>
        
        <dependency>
            <groupId>atlasfrm</groupId>
            <artifactId>atlasfrm-starter-core-eadm</artifactId>
            <version>2.1.0</version>
        </dependency>

        <!-- Dependencias para invocador de servicios de negocio. Descomentar 
            si se desea utilizar esta caracteristica <dependency> <groupId>atlasfrm</groupId> 
            <artifactId>atlasfrm-dep-service</artifactId> <type>pom</type> </dependency> -->

        <!-- Dependencias para invocador de servicios de webServices. Descomentar 
            si se desea utilizar esta caracteristica y se tiene clientes webservices 
            <dependency> <groupId>atlasfrm</groupId> <version>2.0.0</version> <artifactId>atlasfrm-starter-clientews</artifactId> 
            </dependency> -->
    </dependencies>

    <build>
        <plugins>
            <!-- Plugin para invocador de servicios de negocio. Descomentar 
                si se desea utilizar esta caracteristica -->
            <!-- <plugin> <groupId>atlasfrm</groupId> <artifactId>atlasfrm-clientews-wsdl2code-maven-plugin</artifactId> 
                <version>${atlasfrm-clientews-wsdl2code-plugin.version}</version> <configuration> 
                <packageName>org.madrid.saii.lib.ws.client.ptfr</packageName> <serviceNameAsPackage>true</serviceNameAsPackage> 
                <overWrite>false</overWrite> </configuration> <executions> <execution> <id>ServiciosPTFR</id> 
                <configuration> <wsdlFile>src/main/resources/wsdl/PTFR_WS_WSDL.wsdl</wsdlFile> 
                </configuration> <goals> <goal>wsdl2code</goal> </goals> </execution> </executions> 
                </plugin> -->
            <plugin>
                <groupId>atlasfrm.release.plugins</groupId>
                <artifactId>atlasfrm-release-maven-plugin</artifactId>
                <version>1.0.0</version>
                <configuration>
                    <partialRelease>true</partialRelease>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
